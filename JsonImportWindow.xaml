<Window x:Class="CodexAccountBar.JsonImportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Import Codex account JSON" Width="700" Height="520" MinWidth="520" MinHeight="360" WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" FontFamily="Segoe UI" ShowInTaskbar="False">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Paste account JSON" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Paste the JSON containing accessToken, refreshToken, and idToken." Foreground="{StaticResource Muted}" Margin="0,4,0,12" TextWrapping="Wrap"/></StackPanel><TextBox x:Name="JsonTextBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" Padding="10" Background="#111516" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}" AutomationProperties.Name="Account JSON"/><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Style="{StaticResource ActionButton}" Click="Paste_Click" Margin="0,0,8,0">Paste</Button><Button Style="{StaticResource ActionButton}" Click="Cancel_Click" Margin="0,0,8,0">Cancel</Button><Button Style="{StaticResource ActionButton}" Click="Import_Click" IsDefault="True">Import</Button></StackPanel></Grid>
</Window>
