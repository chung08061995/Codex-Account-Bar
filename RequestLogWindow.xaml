<Window x:Class="CodexAccountBar.RequestLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Request Log" Icon="Assets/app-icon.png" Width="1100" Height="640"
        MinWidth="820" MinHeight="420" Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Request Log" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Latest 500 logged HTTP model requests from the last 7 days, newest first." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal"><Button x:Name="TrackingButton" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="Tracking_Click" AutomationProperties.Name="Toggle request tracking">Enable tracking</Button><Button x:Name="RefreshButton" Style="{StaticResource ActionButton}" Click="Refresh_Click" AutomationProperties.Name="Refresh request log">Refresh</Button></StackPanel>
        </Grid>
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Account" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="AccountFilter" Width="280" HorizontalAlignment="Left" SelectionChanged="AccountFilter_SelectionChanged" AutomationProperties.Name="Filter request log by request account"/>
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource Muted}"/>
        </DockPanel>
        <DataGrid x:Name="LogGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                  Background="{StaticResource Surface}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"
                  HorizontalGridLinesBrush="{StaticResource Border}" RowBackground="{StaticResource Surface}" AlternatingRowBackground="{StaticResource Surface2}"
                  EnableRowVirtualization="True" SelectionMode="Single" AutomationProperties.Name="Recent Codex requests">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource Surface2}"/>
                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                    <Setter Property="Padding" Value="10"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
                <Style x:Key="LogText" TargetType="TextBlock">
                    <Setter Property="Margin" Value="8,9"/>
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time (local)" Binding="{Binding LocalTime}" SortMemberPath="Timestamp" Width="195" ElementStyle="{StaticResource LogText}"/>
                <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="235" ElementStyle="{StaticResource LogText}"/>
                <DataGridTemplateColumn Header="Session name" SortMemberPath="SessionName" Width="*" MinWidth="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><TextBlock Text="{Binding SessionName}" Style="{StaticResource LogText}"><TextBlock.ToolTip><StackPanel MaxWidth="500"><TextBlock Text="{Binding SessionName}" TextWrapping="Wrap" Foreground="Black"/><TextBlock Text="{Binding SessionId}" Margin="0,5,0,0" Foreground="Black"/></StackPanel></TextBlock.ToolTip></TextBlock></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="135" ElementStyle="{StaticResource LogText}"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95" ElementStyle="{StaticResource LogText}"/>
                <DataGridTextColumn Header="Tokens" Binding="{Binding TokenText}" Width="110" ElementStyle="{StaticResource LogText}"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Text="Loading request log..." TextWrapping="Wrap"/>
            <TextBlock Text="Account comes from the authentication header sent with each captured request. Tracking forwards requests locally to OpenAI and stores metadata only. Reload VS Code after enabling or disabling tracking. Older requests without capture remain Not recorded. Tokens are reported usage, not a quota percentage; failed requests do not confirm token consumption."
                       Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0"/>
        </StackPanel>
    </Grid>
</Window>
